# Copiar a .env (iniciar.ps1 lo hace solo). .env NO se sube a git.

# --- Modelo local ---
# Dónde está el servidor del modelo (iniciar.ps1 lo ajusta solo según el modo de arranque):
#   LM Studio en Windows:  http://host.docker.internal:1234
#   llama.cpp en Docker:   http://llamacpp:8080
LOCAL_URL=http://host.docker.internal:1234

# Identificador del modelo tal y como lo lista el servidor (ia → opción 6). Vacío = el primero disponible.
LOCAL_MODEL=

# --- Solo llama.cpp (qué modelo elegir según el hardware: README, apartado 2) ---
# Repositorio GGUF de Hugging Face y cuantización
LLAMACPP_HF_REPO=unsloth/Qwen3.5-9B-GGUF:Q4_K_M
# Contexto: 32768 recomendado para agentes; si no cabe, 16384
LLAMACPP_CTX=32768
# true = expertos MoE en la RAM. Solo para modelos MoE que no caben en la GPU (p. ej. 35B-A3B en 8-12 GB)
LLAMACPP_CPU_MOE=false

# --- Claude por API (opcional) ---
# Solo si se paga por uso en console.anthropic.com. Con suscripción Pro/Max/Team déjalo vacío.
ANTHROPIC_API_KEY=
# Modelo de Claude para OpenCode (opción 5). Vacío = elegirlo dentro con /models
CLAUDE_MODEL=

# --- Git (opcional; se configura al arrancar) ---
GIT_USER_NAME=
GIT_USER_EMAIL=
