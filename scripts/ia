#!/usr/bin/env bash
set -euo pipefail

LOCAL_URL="${LOCAL_URL:-http://host.docker.internal:1234}"
LOCAL_MODEL="${LOCAL_MODEL:-}"

local_models() { curl -sf --max-time 5 "$LOCAL_URL/v1/models" | jq -r '.data[].id'; }

need_local_model() {
  curl -sf --max-time 5 "$LOCAL_URL/v1/models" >/dev/null \
    || { echo "Sin servidor de modelos en $LOCAL_URL"; exit 1; }
  if [ -z "$LOCAL_MODEL" ]; then
    LOCAL_MODEL="$(local_models | grep -viE 'embed' | head -1)"
    [ -n "$LOCAL_MODEL" ] || { echo "No hay ningún modelo cargado"; exit 1; }
  elif ! local_models | grep -qxF "$LOCAL_MODEL"; then
    echo "Modelo '$LOCAL_MODEL' no disponible"; exit 1
  fi
}

need_api_key() {
  [ -n "${ANTHROPIC_API_KEY:-}" ] || { echo "Falta ANTHROPIC_API_KEY en .env"; exit 1; }
}

write_opencode_config() {
  mkdir -p "$HOME/.config/opencode"
  local models='{}'
  [ -n "$LOCAL_MODEL" ] && models="{\"$LOCAL_MODEL\": {\"name\": \"$LOCAL_MODEL\"}}"
  cat > "$HOME/.config/opencode/opencode.json" <<EOF
{
  "\$schema": "https://opencode.ai/config.json",
  "provider": {
    "local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Modelo local",
      "options": { "baseURL": "$LOCAL_URL/v1" },
      "models": $models
    }
  }
}
EOF
}

claude_suscripcion() {
  exec env -u ANTHROPIC_API_KEY -u ANTHROPIC_BASE_URL -u ANTHROPIC_AUTH_TOKEN claude "$@"
}

claude_api() {
  need_api_key
  exec env -u ANTHROPIC_BASE_URL -u ANTHROPIC_AUTH_TOKEN claude "$@"
}

claude_local() {
  need_local_model
  exec env -u ANTHROPIC_API_KEY \
    ANTHROPIC_BASE_URL="$LOCAL_URL" \
    ANTHROPIC_AUTH_TOKEN=local \
    ANTHROPIC_DEFAULT_OPUS_MODEL="$LOCAL_MODEL" \
    ANTHROPIC_DEFAULT_SONNET_MODEL="$LOCAL_MODEL" \
    ANTHROPIC_DEFAULT_HAIKU_MODEL="$LOCAL_MODEL" \
    CLAUDE_CODE_ATTRIBUTION_HEADER=0 \
    CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 \
    claude --model "$LOCAL_MODEL" "$@"
}

opencode_local() {
  need_local_model
  write_opencode_config
  exec env -u ANTHROPIC_API_KEY opencode -m "local/$LOCAL_MODEL" "$@"
}

opencode_api() {
  need_api_key
  write_opencode_config
  if [ -n "${CLAUDE_MODEL:-}" ]; then exec opencode -m "anthropic/$CLAUDE_MODEL" "$@"; fi
  exec opencode "$@"
}

modelos() {
  curl -sf --max-time 5 "$LOCAL_URL/v1/models" >/dev/null \
    || { echo "Sin servidor de modelos en $LOCAL_URL"; exit 1; }
  local_models
}

opcion="${1:-}"
[ $# -gt 0 ] && shift

if [ -z "$opcion" ]; then
  cat <<EOF

  Claude Code
    1) Suscripción Claude
    2) API Anthropic
    3) Modelo local

  OpenCode
    4) Modelo local
    5) API Anthropic

    6) Modelos locales
    0) Salir

EOF
  read -rp "  > " opcion
fi

case "$opcion" in
  1) claude_suscripcion "$@" ;;
  2) claude_api "$@" ;;
  3) claude_local "$@" ;;
  4) opencode_local "$@" ;;
  5) opencode_api "$@" ;;
  6) modelos ;;
  0|"") exit 0 ;;
  *) echo "Opción no válida"; exit 1 ;;
esac
