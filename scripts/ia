#!/usr/bin/env bash
set -euo pipefail

if [ "$(id -u)" = 0 ]; then
  exec setpriv --reuid=node --regid=node --init-groups -- "$0" "$@"
fi

LOCAL_URL="${LOCAL_URL:-http://host.docker.internal:1234}"
LOCAL_MODEL="${LOCAL_MODEL:-}"
PLANTILLAS=/usr/local/share/entorno-ia

local_models() { curl -sf --max-time 3 "$LOCAL_URL/v1/models" | jq -r '.data[].id' | grep -viE 'embed' || true; }

server_hint() {
  case "$LOCAL_URL" in
    *llamacpp*) echo "  → llama.cpp puede estar descargando el modelo. En Windows: docker compose logs -f llamacpp" ;;
    *)          echo "  → LM Studio: Developer → Start Server (puerto 1234)" ;;
  esac
}

need_local_model() {
  if ! curl -sf --max-time 3 "$LOCAL_URL/v1/models" >/dev/null; then
    echo "Sin servidor de modelos en $LOCAL_URL"; server_hint; exit 1
  fi
  local models
  models="$(local_models)"
  if [ -z "$LOCAL_MODEL" ]; then
    LOCAL_MODEL="${models%%$'\n'*}"
    [ -n "$LOCAL_MODEL" ] || { echo "No hay ningún modelo cargado"; echo "  → LM Studio: carga uno en la pestaña Developer"; exit 1; }
  elif ! grep -qxF -- "$LOCAL_MODEL" <<<"$models"; then
    echo "Modelo '$LOCAL_MODEL' no disponible. Modelos en el servidor:"; while IFS= read -r m; do echo "  - $m"; done <<<"$models"
    echo "  → Corrige LOCAL_MODEL en .env (o déjalo vacío) y vuelve a ejecutar iniciar.cmd"; exit 1
  fi
}

need_api_key() {
  [ -n "${ANTHROPIC_API_KEY:-}" ] && return
  echo "Falta ANTHROPIC_API_KEY"
  echo "  → Añádela en el archivo .env y vuelve a ejecutar iniciar.cmd"
  exit 1
}

write_opencode_config() {
  mkdir -p "$HOME/.config/opencode"
  jq -n --arg url "$LOCAL_URL/v1" --arg model "$LOCAL_MODEL" --arg rules "$PLANTILLAS/ENTORNO.md" '{
    "$schema": "https://opencode.ai/config.json",
    instructions: [$rules],
    provider: {
      local: {
        npm: "@ai-sdk/openai-compatible",
        name: "Modelo local",
        options: { baseURL: $url },
        models: (if $model == "" then {} else { ($model): { name: $model } } end)
      }
    }
  }' > "$HOME/.config/opencode/opencode.json"
}

gh_user() { gh config get -h github.com user 2>/dev/null || true; }

claude_suscripcion() {
  exec env -u ANTHROPIC_API_KEY -u ANTHROPIC_BASE_URL -u ANTHROPIC_AUTH_TOKEN claude "$@"
}

claude_autonomo() {
  if [ "${FIREWALL:-on}" = "off" ]; then
    echo "El cortafuegos está desactivado (FIREWALL=off)."
    echo "Sin él, el modo autónomo puede conectarse a cualquier sitio sin preguntarte."
    read -rp "¿Seguir de todos modos? (s/N) " r
    [[ $r == [sS] ]] || exit 1
  fi
  exec env -u ANTHROPIC_API_KEY -u ANTHROPIC_BASE_URL -u ANTHROPIC_AUTH_TOKEN \
    claude --dangerously-skip-permissions "$@"
}

claude_api() {
  need_api_key
  exec env -u ANTHROPIC_BASE_URL -u ANTHROPIC_AUTH_TOKEN claude "$@"
}

opencode_libre() {
  write_opencode_config
  if [ -n "${ANTHROPIC_API_KEY:-}" ] && [ -n "${CLAUDE_MODEL:-}" ]; then
    exec opencode -m "anthropic/$CLAUDE_MODEL" "$@"
  fi
  exec opencode "$@"
}

opencode_local() {
  need_local_model
  write_opencode_config
  exec env -u ANTHROPIC_API_KEY opencode -m "local/$LOCAL_MODEL" "$@"
}

modelos() {
  if ! curl -sf --max-time 3 "$LOCAL_URL/v1/models" >/dev/null; then
    echo "Sin servidor de modelos en $LOCAL_URL"; server_hint; exit 1
  fi
  local_models
}

github() {
  local u
  u="$(gh_user)"
  if [ -n "$u" ] && gh auth status -h github.com >/dev/null 2>&1; then
    echo "Ya estás conectado a GitHub como $u."
    read -rp "¿Conectar otra cuenta? (s/N) " r
    [[ $r == [sS] ]] || exit 0
  fi
  echo
  echo "Vas a conectar GitHub con un código de un solo uso:"
  echo "  1. Copia el código que aparece a continuación."
  echo "  2. Abre https://github.com/login/device en el navegador y pégalo."
  echo "  3. Si te pregunta por las credenciales de Git, pulsa Enter."
  echo
  gh auth login -h github.com -p https -w
  gh auth setup-git
  echo
  echo "Conectado a GitHub como $(gh_user)."
}

preparar() {
  local url="${1:-}" nombre="${PROYECTO:-proyecto}"
  cd /workspace
  if [ -n "$(ls -A)" ]; then
    echo "El proyecto ya tiene archivos: no se cambia nada."
    return 0
  fi
  if [ -n "$url" ]; then
    echo "Descargando $url ..."
    local ok=0
    if [[ $url != *://* || $url == *github.com* ]] && gh auth status -h github.com >/dev/null 2>&1; then
      gh repo clone "$url" . && ok=1
    else
      GIT_TERMINAL_PROMPT=0 git clone "$url" . && ok=1
    fi
    if [ "$ok" = 0 ]; then
      echo
      echo "No se pudo descargar el repositorio."
      echo "  → Si es privado: conecta GitHub y vuelve a intentarlo."
      echo "  → Si no está en GitHub: añade su dominio a FIREWALL_ALLOW en .env."
      return 1
    fi
    [ -f CLAUDE.md ] || [ -f AGENTS.md ] || echo "Consejo: el proyecto no tiene CLAUDE.md. Pídele a Claude Code: /init"
  else
    git init -q -b main
    sed "s/NOMBRE_PROYECTO/$nombre/" "$PLANTILLAS/CLAUDE.md" > CLAUDE.md
    cp "$PLANTILLAS/gitignore" .gitignore
    echo "Proyecto vacío creado, con un CLAUDE.md de plantilla para los agentes."
  fi
}

# Cambios sin subir a GitHub, para avisar antes de borrar un proyecto.
pendiente() {
  cd /workspace
  [ -n "$(ls -A)" ] || return 0
  if [ ! -d .git ]; then echo "archivos que no están en git"; return 0; fi
  [ -z "$(git status --porcelain 2>/dev/null)" ] || echo "cambios sin guardar en git (commit)"
  if [ -z "$(git remote)" ]; then
    [ -z "$(git rev-parse -q --verify HEAD 2>/dev/null)" ] || echo "commits que no están subidos (sin repositorio remoto)"
  elif [ -n "$(git log --branches --not --remotes --oneline 2>/dev/null | head -1)" ]; then
    echo "commits sin subir (push)"
  fi
}

estado_local() {
  local m
  if ! curl -sf --max-time 2 "$LOCAL_URL/v1/models" >/dev/null; then echo "sin servidor"; return; fi
  m="$(local_models)"
  m="${LOCAL_MODEL:-${m%%$'\n'*}}"
  echo "${m:-sin modelo cargado}"
}

ayuda() {
  cat <<EOF
Uso: ia [comando] [argumentos para la herramienta]

  ia               menú
  ia claude        Claude Code con tu cuenta de Claude
  ia auto          Claude Code autónomo (no pide permiso en cada paso)
  ia opencode      OpenCode: eliges proveedor y modelo dentro (/models, /connect)
  ia local         OpenCode con el modelo local (LM Studio o llama.cpp)
  ia claude-api    Claude Code con ANTHROPIC_API_KEY
  ia modelos       lista los modelos locales
  ia github        conecta tu cuenta de GitHub

Ejemplo: ia claude -c   (continúa la última conversación)
EOF
}

opcion="${1:-}"
[ $# -gt 0 ] && shift

if [ -z "$opcion" ]; then
  [ -n "${ANTHROPIC_API_KEY:-}" ] && api="configurada" || api="sin configurar"
  gh="$(gh_user)"
  cat <<EOF

  Proyecto: ${PROYECTO:-general}
  Modelo local: $(estado_local)  ·  API Anthropic: $api  ·  GitHub: ${gh:-sin conectar}

  TRABAJAR CON IA
    1) Claude Code             con tu cuenta de Claude
    2) Claude Code autónomo    no pide permiso en cada paso
    3) OpenCode                eliges proveedor y modelo dentro
    4) OpenCode local          con el modelo de LM Studio o llama.cpp

  OTROS
    5) Conectar GitHub
    6) Claude Code con clave de API
    7) Ver modelos locales
    0) Salir

EOF
  read -rp "  > " opcion
fi

case "$opcion" in
  1|claude)       claude_suscripcion "$@" ;;
  2|auto)         claude_autonomo "$@" ;;
  3|opencode)     opencode_libre "$@" ;;
  4|local)        opencode_local "$@" ;;
  5|github)       github ;;
  6|claude-api)   claude_api "$@" ;;
  7|modelos)      modelos ;;
  preparar)       preparar "$@" ;;
  pendiente)      pendiente ;;
  --estado)
    [ -n "${ANTHROPIC_API_KEY:-}" ] && api="configurada" || api="sin configurar"
    echo "$(estado_local)|$api|$(gh_user)" ;;
  -h|--help|help) ayuda ;;
  0|"") exit 0 ;;
  *) echo "Opción no válida: $opcion"; ayuda; exit 1 ;;
esac
