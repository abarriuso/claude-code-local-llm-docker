#!/usr/bin/env bash
set -euo pipefail

LOCAL_URL="${LOCAL_URL:-http://host.docker.internal:1234}"
LOCAL_MODEL="${LOCAL_MODEL:-}"

local_models() { curl -sf --max-time 3 "$LOCAL_URL/v1/models" | jq -r '.data[].id' | grep -viE 'embed' || true; }

server_hint() {
  case "$LOCAL_URL" in
    *llamacpp*) echo "  → llama.cpp puede estar descargando el modelo. En Windows: docker compose logs -f llamacpp" ;;
    *)          echo "  → LM Studio: Developer → Start Server (puerto 1234)" ;;
  esac
}

need_local_model() {
  if ! curl -sf --max-time 3 "$LOCAL_URL/v1/models" >/dev/null; then
    echo "Sin servidor de modelos en $LOCAL_URL"; server_hint; exit 1
  fi
  local models
  models="$(local_models)"
  if [ -z "$LOCAL_MODEL" ]; then
    LOCAL_MODEL="${models%%$'\n'*}"
    [ -n "$LOCAL_MODEL" ] || { echo "No hay ningún modelo cargado"; echo "  → LM Studio: carga uno en la pestaña Developer"; exit 1; }
  elif ! grep -qxF -- "$LOCAL_MODEL" <<<"$models"; then
    echo "Modelo '$LOCAL_MODEL' no disponible. Modelos en el servidor:"; while IFS= read -r m; do echo "  - $m"; done <<<"$models"
    echo "  → Corrige LOCAL_MODEL en .env (o déjalo vacío) y ejecuta: docker compose up -d"; exit 1
  fi
}

need_api_key() {
  [ -n "${ANTHROPIC_API_KEY:-}" ] && return
  echo "Falta ANTHROPIC_API_KEY"
  echo "  → Añádela en .env y ejecuta en Windows: docker compose up -d"
  exit 1
}

write_opencode_config() {
  mkdir -p "$HOME/.config/opencode"
  local models='{}'
  [ -n "$LOCAL_MODEL" ] && models="{\"$LOCAL_MODEL\": {\"name\": \"$LOCAL_MODEL\"}}"
  cat > "$HOME/.config/opencode/opencode.json" <<EOF
{
  "\$schema": "https://opencode.ai/config.json",
  "provider": {
    "local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Modelo local",
      "options": { "baseURL": "$LOCAL_URL/v1" },
      "models": $models
    }
  }
}
EOF
}

claude_suscripcion() {
  exec env -u ANTHROPIC_API_KEY -u ANTHROPIC_BASE_URL -u ANTHROPIC_AUTH_TOKEN claude "$@"
}

claude_api() {
  need_api_key
  exec env -u ANTHROPIC_BASE_URL -u ANTHROPIC_AUTH_TOKEN claude "$@"
}

claude_local() {
  need_local_model
  exec env -u ANTHROPIC_API_KEY \
    ANTHROPIC_BASE_URL="$LOCAL_URL" \
    ANTHROPIC_AUTH_TOKEN=local \
    ANTHROPIC_DEFAULT_OPUS_MODEL="$LOCAL_MODEL" \
    ANTHROPIC_DEFAULT_SONNET_MODEL="$LOCAL_MODEL" \
    ANTHROPIC_DEFAULT_HAIKU_MODEL="$LOCAL_MODEL" \
    CLAUDE_CODE_ATTRIBUTION_HEADER=0 \
    CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 \
    claude --model "$LOCAL_MODEL" "$@"
}

opencode_local() {
  need_local_model
  write_opencode_config
  exec env -u ANTHROPIC_API_KEY opencode -m "local/$LOCAL_MODEL" "$@"
}

opencode_api() {
  need_api_key
  write_opencode_config
  if [ -n "${CLAUDE_MODEL:-}" ]; then exec opencode -m "anthropic/$CLAUDE_MODEL" "$@"; fi
  exec opencode "$@"
}

modelos() {
  if ! curl -sf --max-time 3 "$LOCAL_URL/v1/models" >/dev/null; then
    echo "Sin servidor de modelos en $LOCAL_URL"; server_hint; exit 1
  fi
  local_models
}

ayuda() {
  cat <<EOF
Uso: ia [opción] [argumentos de la herramienta]

  ia          menú
  ia 1        Claude Code con la suscripción
  ia 4 -c     OpenCode con modelo local, continuando la última sesión
EOF
}

estado_local() {
  local m
  if ! curl -sf --max-time 2 "$LOCAL_URL/v1/models" >/dev/null; then echo "sin servidor"; return; fi
  m="$(local_models)"
  m="${LOCAL_MODEL:-${m%%$'\n'*}}"
  echo "${m:-sin modelo cargado}"
}

opcion="${1:-}"
[ $# -gt 0 ] && shift

if [ -z "$opcion" ]; then
  [ -n "${ANTHROPIC_API_KEY:-}" ] && api="configurada" || api="sin configurar"
  cat <<EOF

  Modelo local: $(estado_local)
  API Anthropic: $api

  Claude Code
    1) Suscripción Claude
    2) API Anthropic
    3) Modelo local

  OpenCode
    4) Modelo local
    5) API Anthropic

    6) Modelos locales
    0) Salir

EOF
  read -rp "  > " opcion
fi

case "$opcion" in
  1) claude_suscripcion "$@" ;;
  2) claude_api "$@" ;;
  3) claude_local "$@" ;;
  4) opencode_local "$@" ;;
  5) opencode_api "$@" ;;
  6) modelos ;;
  -h|--help|help) ayuda ;;
  0|"") exit 0 ;;
  *) echo "Opción no válida: $opcion"; ayuda; exit 1 ;;
esac
