{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "build",
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "edit": "ask",
    "bash": {
      "*": "ask",
      "ls": "allow",
      "ls *": "allow",
      "pwd": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow"
    },
    "webfetch": "ask",
    "external_directory": {
      "*": "deny",
      "/tmp/opencode/*": "allow"
    }
  },
  "agent": {
    "build": {
